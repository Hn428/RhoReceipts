{
  "name": "rho-receipts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "demo": "node scripts/demo.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "fixtures": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-rho-fixtures.ts",
    "sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync.ts",
    "db:generate": "drizzle-kit generate",
    "db:reset": "rm -rf \"${PGLITE_DIR:-$HOME/.cache/rho-receipts/pglite}\" && echo \"embedded database removed\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
