# Rho API. Defaults point at the in-repo mock, which serves the committed
# fixture dataset (Northstar Labs, 18 months). Swap both values for a real
# rhobat_ token when the live API is available — no code changes needed.
RHO_API_BASE_URL="http://localhost:3000/api/mock/rho/v1"
RHO_API_TOKEN="rhobat_mock_northstar_labs_dev_token"

# Token the mock API accepts. Keep in sync with RHO_API_TOKEN above.
RHO_MOCK_TOKEN="rhobat_mock_northstar_labs_dev_token"

# Envelope encryption master key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Reporting timezone for month boundaries.
REPORTING_TIME_ZONE="America/New_York"

# Optional live customer web research. Sample companies always use labelled simulation.
# TAVILY_API_KEY="tvly-..."

# Where the embedded database lives. Defaults to ~/.cache/rho-receipts/pglite —
# deliberately OUTSIDE the project, because a file-syncing service (iCloud,
# Dropbox) will duplicate files inside a Postgres data directory and corrupt it.
# PGLITE_DIR=""

# Set these to use Supabase instead of the embedded database. Nothing else
# changes — same schema, same migrations. See docs/database.md.
#
# The app connects through the transaction pooler (port 6543):
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
#
# `npm run db:migrate` connects through the session pooler (port 5432):
# DATABASE_MIGRATION_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
